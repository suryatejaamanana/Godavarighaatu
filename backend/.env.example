APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
# Supabase pooler connection (app) - fill in from your Supabase project
DATABASE_URL=
# Required for admin login. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_MAX_DAYS=30
# Must be true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=5/minute
REFRESH_RATE_LIMIT=30/minute
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
STORAGE_BACKEND=local
MEDIA_ROOT=media
PUBLIC_MEDIA_URL=http://localhost:8000/media
MAX_UPLOAD_MB=10
